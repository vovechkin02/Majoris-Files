project('majoris-files', ['vala', 'c'], version: '0.1.0', license: 'GPL-3.0-or-later', meson_version: '>=1.6')
gnome = import('gnome')
majoris_ui = dependency('majoris-ui-gtk4', version: '>=0.1.0', required: true)
add_project_arguments('-DGETTEXT_PACKAGE="majoris-files"', language: 'c')
deps = [dependency('gtk4', version: '>=4.18'), dependency('libadwaita-1', version: '>=1.5'), dependency('gee-0.8'), dependency('gio-unix-2.0'), dependency('sqlite3'), dependency('json-glib-1.0')]
deps += majoris_ui
deps += [dependency('poppler-glib'), dependency('libarchive'), dependency('gtk4-wayland'), dependency('gtk4-x11'), dependency('x11')]
deps += dependency('libportal-gtk4', version: '>=0.7')
deps += dependency('cloudproviders', version: '>=0.3')
deps += dependency('gtksourceview-5', version: '>=5.6')
deps += dependency('tinysparql-3.0', version: '>=3.8')
add_project_arguments('--pkg=libarchive', language: 'vala')
# Diagnostics in generated C; semantic Vala warnings remain enabled.
add_project_arguments('-Wno-unused-variable', '-Wno-unused-but-set-variable', '-Wno-unused-function', '-Wno-discarded-qualifiers', language: 'c')
core = files('src/utils/paths.vala', 'src/models/file-item.vala', 'src/models/directory-model.vala', 'src/navigation/history.vala', 'src/metadata/store.vala', 'src/sidebar/places.vala', 'src/search/search.vala', 'src/operations/manager.vala', 'src/chooser/options.vala', 'src/split/split.vala')
ui = files('src/views/browser.vala', 'src/preview/preview.vala', 'src/window/window.vala', 'src/chooser/window.vala')
core += files('src/dialogs/dialogs.vala')
core += files('src/models/counts.vala')
core += files('src/utils/i18n.vala')
core += files('src/operations/permissions.vala')
core += files('src/search/indexed.vala')
core += files('src/operations/replacements.vala')
core += files('src/operations/durability.vala', 'src/operations/durability.c')
core += files('src/operations/rename-plan.vala')
core += files('src/operations/rename-recovery.vala')
core += files('src/archive/archive.vala', 'src/archive/native.c')
core += files('src/archive/sevenzip.vala')
core += files('src/chooser/state.vala')
core += files('src/chooser/import.vala')
core += files('src/operations/clipboard.vala')
core += files('src/operations/drop-policy.vala')
core += files('src/navigation/completion.vala')
core += files('src/models/accounts.vala')
core += files('src/sidebar/cloud.vala')
core += files('src/cloud/files.vala')
ui += files('src/search/filters.vala')
ui += files('src/metadata/tags-dialog.vala')
ui += files('src/metadata/details.vala')
ui += files('src/views/home.vala', 'src/window/theme.vala')
ui += gnome.compile_resources('files-resources', 'data/files.gresource.xml', source_dir: 'data', c_name: 'majoris_files')
ui += files('src/application/launcher.vala')
ui += files('src/application/shell-search.vala')
ui += files('src/preview/archive.vala')
ui += files('src/preview/office.vala')
ui += files('src/preview/animation.vala')
ui += files('src/preview/sandbox.vala')
ui += files('src/preview/playback.vala','src/preview/playback.c')
deps += [dependency('gstreamer-app-1.0')]
ui += files('src/devices/disk-images.vala')
ui += files('src/views/column-provider.vala')
ui += files('src/views/file-groups.vala')
ui += files('src/views/grid-rows.vala')
ui += configure_file(input: 'src/preview/config.vala.in', output: 'preview-config.vala', configuration: {'office_source_helper_path': meson.project_source_root() / 'src/preview/office-render.py', 'office_helper_path': get_option('prefix') / get_option('libexecdir') / 'majoris-files-office-render.py', 'helper_path': get_option('prefix') / get_option('libexecdir') / 'majoris-files-preview-helper'})
preview_helper = executable('majoris-files-preview-helper', 'src/preview/helper.c', 'src/preview/media.c', 'src/preview/playback-worker.c', 'src/preview/image-metadata.c', 'src/preview/image-decoders.c', 'src/preview/rotation.c', 'src/archive/native.c', dependencies: [dependency('gio-2.0'), dependency('poppler-glib'), dependency('libarchive'), dependency('pangocairo'), dependency('pangoft2'), dependency('fontconfig'), dependency('gdk-pixbuf-2.0'), dependency('gexiv2'), dependency('libraw'), dependency('libheif', version: '>=1.19'), dependency('lcms2'), dependency('libturbojpeg'), dependency('gstreamer-pbutils-1.0'), dependency('gstreamer-app-1.0'), dependency('gstreamer-video-1.0'), dependency('libcmark'), dependency('json-glib-1.0')], link_args: ['-lm'], install: true, install_dir: get_option('libexecdir'))
ui += files('src/actions/registry.vala', 'src/actions/rotation.vala')
ui += files('src/extensions/manager.vala')
ui += files('src/actions/desktop.vala')
ui += files('src/actions/nearby.vala')
ui += files('src/dialogs/permissions.vala')
ui += files('src/dialogs/associations.vala')
ui += files('src/dialogs/preferences.vala')
ui += files('src/dialogs/shortcuts.vala')
ui += files('src/dialogs/split.vala')
ui += files('src/dialogs/checksum.vala')
ui += files('src/dialogs/sevenzip.vala')
ui += files('src/dialogs/batch-rename.vala')
ui += files('src/sharing/settings.vala')
ui += files('src/portal/parent.vala', 'src/portal/parent.c', 'src/preview/pdf.vala', 'src/preview/thumbnail.vala', 'src/sharing/sharing.vala', 'src/window/extra-actions.vala', 'src/application/file-manager.vala')
files_app = executable('majoris-files', 'src/application/main.vala', core, ui, dependencies: deps, install: true)
executable('majoris-files-portal', 'src/portal/main.vala', 'src/portal/backend.vala', core, ui, dependencies: deps, install: true)
executable('majoris-files-sharing-service', 'sharing-service/main.vala', 'sharing-service/firewall.vala', 'sharing-service/clients.vala', 'sharing-service/visibility.vala', dependencies: [dependency('gio-2.0'), dependency('gee-0.8'), dependency('json-glib-1.0'), dependency('polkit-gobject-1')], vala_args: ['--pkg=posix'], install: true, install_dir: get_option('libexecdir'))
configure_file(input: 'data/com.majoris.Files.Sharing.service.in', output: 'com.majoris.Files.Sharing.service', configuration: {'libexecdir': get_option('prefix') / get_option('libexecdir')}, install_dir: get_option('datadir') / 'dbus-1/system-services')
configure_file(input: 'data/majoris-files-sharing.service.in', output: 'majoris-files-sharing.service', configuration: {'libexecdir': get_option('prefix') / get_option('libexecdir')}, install_dir: get_option('prefix') / 'lib/systemd/system')
install_data('data/com.majoris.Files.Sharing.conf', install_dir: get_option('datadir') / 'dbus-1/system.d')
install_data('data/com.majoris.files.sharing.policy', install_dir: get_option('datadir') / 'polkit-1/actions')
tests = executable('core-tests', 'tests/core.vala', core, dependencies: deps)
test('core', tests)
cloud_tests = executable('cloud-tests', 'tests/cloud.vala', core, dependencies: deps)
test('cloud', find_program('dbus-run-session'), args: ['--', cloud_tests], timeout: 30)
replacement_tests = executable('replacement-crash-tests', 'tests/replacement-crash.vala', core, dependencies: deps)
test('replacement-crash', replacement_tests, timeout: 60)
archive_crash=executable('archive-crash-tests','tests/archive-crash.vala',core,dependencies:deps)
test('archive-crash',archive_crash,timeout:60)
image_tests = executable('image-decoder-tests', 'tests/image-decoders.c', 'src/preview/image-decoders.c', dependencies: [dependency('gio-2.0'), dependency('gdk-pixbuf-2.0'), dependency('libraw'), dependency('libheif'), dependency('lcms2'), dependency('libtiff-4'), dependency('json-glib-1.0')], link_args: ['-lm'], include_directories: include_directories('.'))
test('image-decoders', image_tests, timeout: 60)
firewall_tests = executable('firewall-tests', 'tests/firewall.vala', 'sharing-service/firewall.vala', 'sharing-service/clients.vala', dependencies: [dependency('gio-2.0'), dependency('json-glib-1.0')])
test('firewall', firewall_tests)
filesystem_tests = executable('filesystem-tests', 'tests/filesystem.vala', core, dependencies: deps)
test('filesystem', filesystem_tests, timeout: 60)
performance_check = executable('performance-check', 'tests/performance.vala', core, dependencies: deps)
benchmark('directory-10000', performance_check, timeout: 120)
benchmark('directory-100000', performance_check, args: ['100000'], timeout: 180)
benchmark('search-covered-10000',performance_check,args:['--search'],timeout:180)
smoke = executable('ui-tests', 'tests/ui.vala', core, ui, dependencies: deps)
executable('visual-check', 'tests/visual.vala', core, ui, dependencies: deps)
executable('remote-check', 'tests/remote.vala', core, ui, dependencies: deps)
flatpak_client = executable('flatpak-client', 'tests/flatpak-client.c', dependencies: dependency('gio-2.0'))
executable('gtk-portal-client', 'tests/flatpak-client.c', c_args: ['-DMAJORIS_GTK_CLIENT'], dependencies: dependency('gtk4'))
flatpak_host = executable('flatpak-host', 'tests/flatpak-host.vala', 'src/portal/backend.vala', core, ui, dependencies: deps)
xvfb = find_program('xvfb-run', required: false)
if xvfb.found()
  test('ui', xvfb, args: ['-a', smoke], depends: preview_helper, env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 120)
  portal_tests = executable('portal-tests', 'tests/portal.vala', 'src/portal/backend.vala', core, ui, dependencies: deps)
  dbus_run = find_program('dbus-run-session')
  python = find_program('python3')
  test('session', dbus_run, args: ['--', xvfb, '-a', python, meson.project_source_root() / 'tests/session.py', files_app], env: ['GDK_BACKEND=x11','GSK_RENDERER=cairo','GSETTINGS_BACKEND=memory'], timeout: 45)
  test('portal', dbus_run, args: ['--', xvfb, '-a', portal_tests], env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 30)
endif
install_data('data/com.majoris.files.desktop', install_dir: get_option('datadir') / 'applications')
install_data('data/majoris-mimeapps.list',install_dir:get_option('datadir')/'applications')
install_data('data/com.majoris.files.search-provider.ini', install_dir: get_option('datadir') / 'gnome-shell/search-providers')
install_data('data/com.majoris.files.metainfo.xml', install_dir: get_option('datadir') / 'metainfo')
install_data('data/com.majoris.files.svg', install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps')
install_data('data/majoris.portal', install_dir: get_option('datadir') / 'xdg-desktop-portal/portals')
install_data('data/majoris-portals.conf', install_dir: get_option('datadir') / 'xdg-desktop-portal')
configure_file(input: 'data/org.freedesktop.impl.portal.desktop.majoris.service.in', output: 'org.freedesktop.impl.portal.desktop.majoris.service', configuration: {'bindir': get_option('prefix') / get_option('bindir')}, install_dir: get_option('datadir') / 'dbus-1/services')
configure_file(input: 'data/org.freedesktop.FileManager1.service.in', output: 'org.freedesktop.FileManager1.service', configuration: {'bindir': get_option('prefix') / get_option('bindir')}, install_dir: get_option('datadir') / 'dbus-1/services')
configure_file(input: 'data/com.majoris.files.service.in', output: 'com.majoris.files.service', configuration: {'bindir': get_option('prefix') / get_option('bindir')}, install_dir: get_option('datadir') / 'dbus-1/services')
gnome.post_install(gtk_update_icon_cache: true, update_desktop_database: true)
subdir('po')

install_data('src/preview/office-render.py', rename: 'majoris-files-office-render.py', install_dir: get_option('libexecdir'))

install_data('data/majoris-files-sharing.xml', install_dir: get_option('prefix') / 'lib/firewalld/policies')
if get_option('example_extension')
  install_data('examples/checksum.extension', install_dir: get_option('datadir') / 'majoris-files/extensions')
  install_data('examples/checksum-extension.py', install_dir: get_option('libexecdir'))
  configure_file(input: 'examples/com.majoris.Files.ExampleChecksum.service.in', output: 'com.majoris.Files.ExampleChecksum.service', configuration: {'example_helper': get_option('prefix') / get_option('libexecdir') / 'checksum-extension.py'}, install_dir: get_option('datadir') / 'dbus-1/services')
endif

executable('visibility-check', 'tests/visibility.vala', 'sharing-service/visibility.vala', dependencies: [dependency('gio-2.0'), dependency('json-glib-1.0'), dependency('gee-0.8')])

install_data('data/majoris-samba-foundation.conf', install_dir: get_option('datadir') / 'majoris-files')

redesign_tests = executable('redesign-tests', 'tests/redesign.vala', core, ui, dependencies: deps)
if xvfb.found()
  test('redesign', find_program('dbus-run-session'), args: ['--', xvfb, '-a', redesign_tests], env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 45)
endif

# Theme ownership checks also run without a graphical display.
test('theme-layout', find_program('python3'), args: [meson.project_source_root() / 'tests/theme-layout.py'])
sidebar_tests = executable('sidebar-tests', 'tests/places.vala', core, dependencies: deps)
test('sidebar', find_program('dbus-run-session'), args: ['--', sidebar_tests], timeout: 15)

# Native Files windows and allocation evidence; run with the installed GTK4 theme.
theme_integration = executable('theme-integration', 'tests/theme-integration.vala', 'tests/native-evidence.vala', core, ui, dependencies: deps)

if xvfb.found()
  test('theme-integration-fallback', find_program('dbus-run-session'), args: ['--', xvfb, '-a', theme_integration, meson.project_build_root() / 'theme-integration-fallback'], env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 90)
endif

# Section lifecycle, metadata metrics and real X11 pointer/keyboard input.
details_corrections = executable('details-corrections', 'tests/details-corrections.vala', 'tests/native-evidence.vala', core, ui, dependencies: deps)
if xvfb.found() and find_program('xdotool', required: false).found()
  test('details-corrections', find_program('dbus-run-session'), args: ['--', xvfb, '-a', details_corrections, meson.project_build_root() / 'details-corrections-fallback'], env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 90)
endif

# Consumers exercise the installed public Toolbar ABI; no reference source is compiled here.
toolbar_tests = executable('toolbar-tests', 'tests/toolbars.vala', 'tests/native-evidence.vala', core, ui, dependencies: deps)
if xvfb.found()
  test('toolbars', find_program('dbus-run-session'), args: ['--', xvfb, '-a', toolbar_tests], depends: preview_helper, env: ['GDK_BACKEND=x11', 'GSK_RENDERER=cairo', 'GSETTINGS_BACKEND=memory'], timeout: 90)
endif
