[Unit]
Description=Majoris Files Sharing Service
[Service]
Type=dbus
BusName=com.majoris.Files.Sharing
ExecStart=@libexecdir@/majoris-files-sharing-service
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=majoris-files/share-visibility
StateDirectoryMode=0700
ReadWritePaths=/var/lib/samba
[Install]
WantedBy=multi-user.target
