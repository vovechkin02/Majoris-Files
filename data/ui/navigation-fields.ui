<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesNavigationFields" parent="GtkGrid">
    <property name="column-homogeneous">true</property>
    <property name="column-spacing">8</property>
    <property name="hexpand">true</property>
    <child>
      <object class="GtkStack" id="location_bar">
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">3</property>
        </layout>
        <property name="hexpand">true</property>
        <property name="valign">center</property>
        <style>
          <class name="majoris-location-bar" />
        </style>
        <child>
          <object class="GtkStackPage">
            <property name="name">entry</property>
            <property name="child">
              <object class="GtkEntry" id="path">
                <property name="width-chars">1</property>
                <style>
                  <class name="majoris-location-entry" />
                </style>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">breadcrumbs</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkBox" id="breadcrumbs">
                    <property name="orientation">horizontal</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <property name="visible-child-name">breadcrumbs</property>
      </object>
    </child>
    <child>
      <object class="GtkSearchEntry" id="search_entry">
        <property name="hexpand">true</property>
        <property name="width-chars">8</property>
        <property name="placeholder-text" translatable="yes">Search files</property>
        <style>
          <class name="majoris-toolbar-control" />
        </style>
        <layout>
          <property name="column">3</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
  </template>
</interface>
