<interface domain="majoris-files">
  <template class="MajorisFilesListFileItem" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">8</property>
    <property name="halign">fill</property>
    <property name="valign">center</property>
    <style>
      <class name="majoris-data-cell" />
    </style>
    <child>
      <object class="GtkOverlay" id="icon_area">
        <property name="child">
          <object class="GtkImage" id="icon">
            <property name="halign">center</property>
            <property name="valign">center</property>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkImage" id="cloud_badge">
            <property name="pixel-size">16</property>
            <property name="halign">end</property>
            <property name="valign">end</property>
            <property name="can-target">false</property>
            <property name="visible">false</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="MajorisFilesFilenameCell" id="filename">
        <property name="hexpand">true</property>
        <child internal-child="label">
          <object class="GtkLabel">
            <property name="ellipsize">end</property>
            <property name="max-width-chars">50</property>
            <property name="xalign">0</property>
            <property name="hexpand">true</property>
            <property name="halign">start</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="caption">
        <property name="ellipsize">end</property>
        <property name="max-width-chars">18</property>
        <property name="visible">false</property>
        <style>
          <class name="majoris-data-metadata" />
        </style>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="checkbox">
        <property name="tooltip-text" translatable="yes">Select Item</property>
      </object>
    </child>
  </template>
</interface>