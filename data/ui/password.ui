<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesPasswordDialog" parent="AdwAlertDialog">
    <responses>
      <response id="cancel" translatable="yes">Cancel</response>
      <response id="apply" appearance="suggested" translatable="yes">Continue</response>
    </responses>
    <property name="close-response">cancel</property>
    <property name="default-response">apply</property>
    <property name="extra-child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="AdwPasswordEntryRow" id="entry">
            <property name="title" translatable="yes">Password</property>
          </object>
        </child>
        <child>
          <object class="AdwPasswordEntryRow" id="repeat">
            <property name="title" translatable="yes">Confirm Password</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
