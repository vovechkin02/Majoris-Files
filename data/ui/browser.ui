<interface domain="majoris-files">
  <template class="MajorisFilesBrowser" parent="GtkBox">
    <child>
      <object class="AdwBreakpointBin" id="navigation_adaptive">
        <property name="child">
          <object class="GtkScrolledWindow" id="navigation_scroll">
            <property name="propagate-natural-height">true</property>
            <property name="hexpand">true</property>
            <property name="hscrollbar-policy">external</property>
            <property name="vscrollbar-policy">never</property>
          </object>
        </property>
        <property name="width-request">320</property>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="command_scroll">
        <property name="propagate-natural-height">true</property>
        <property name="hscrollbar-policy">external</property>
        <property name="vscrollbar-policy">never</property>
      </object>
    </child>
    <child>
      <object class="AdwBanner" id="location_error">
        <property name="title" />
        <property name="button-label">Retry</property>
      </object>
    </child>
    <child>
      <object class="AdwBanner" id="metadata_banner">
        <property name="title" />
        <property name="button-label" translatable="yes">Recover Metadata</property>
      </object>
    </child>
    <child>
      <object class="AdwBreakpointBin" id="adaptive">
        <property name="child">
          <object class="AdwOverlaySplitView" id="sidebar_overlay">
            <property name="content">
              <object class="GtkPaned" id="body">
                <property name="orientation">horizontal</property>
                <property name="start-child">
                  <object class="GtkScrolledWindow" id="side_scroll">
                    <property name="width-request">120</property>
                    <property name="child">
                      <object class="GtkListBox" id="sidebar">
                        <property name="selection-mode">single</property>
                        <style>
                          <class name="navigation-sidebar" />
                          <class name="files-sidebar" />
                        </style>
                        <style>
                          </style>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkPaned" id="content">
                    <property name="orientation">horizontal</property>
                    <property name="start-child">
                      <object class="GtkOverlay" id="file_overlay">
                        <child type="overlay">
                          <object class="AdwStatusPage" id="tag_empty">
                            <property name="title" translatable="yes">No tagged files</property>
                            <property name="description" translatable="yes">Assign this tag to files or folders to see them here.</property>
                            <property name="icon-name">tag-symbolic</property>
                            <property name="can-target">false</property>
                            <property name="visible">false</property>
                          </object>
                        </child>
                        <property name="child">
                          <object class="GtkStack" id="views">
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">Grid</property>
                                <property name="child">
                                  <object class="GtkStack" id="grid_views">
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">plain</property>
                                        <property name="child">
                                          <object class="GtkScrolledWindow" id="plain_scroll">
                                            <property name="child">
                                              <object class="GtkGridView" id="grid">
                                                <property name="min-columns">1</property>
                                                <property name="max-columns">16</property>
                                                <property name="enable-rubberband">true</property>
                                              </object>
                                            </property>
                                            <property name="hexpand">true</property>
                                            <property name="vexpand">true</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">grouped</property>
                                        <property name="child">
                                          <object class="GtkScrolledWindow" id="grouped_scroll">
                                            <property name="child">
                                              <object class="GtkListView" id="grouped_grid" />
                                            </property>
                                            <property name="hexpand">true</property>
                                            <property name="vexpand">true</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <property name="visible-child-name">plain</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">List</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow" id="details_scroll">
                                    <property name="child">
                                      <object class="GtkColumnView" id="list">
                                        <property name="show-column-separators">false</property>
                                        <property name="enable-rubberband">true</property>
                                      </object>
                                    </property>
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">true</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">Columns</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow" id="columns_scroll">
                                    <property name="child">
                                      <object class="GtkBox" id="columns">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">1</property>
                                      </object>
                                    </property>
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">true</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">Gallery</property>
                                <property name="child">
                                  <object class="GtkBox" id="gallery">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="MajorisFilesPreviewPane" id="gallery_preview">
                                        <property name="vexpand">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow" id="strip_scroll">
                                        <property name="child">
                                          <object class="GtkListView" id="strip" />
                                        </property>
                                        <property name="hexpand">true</property>
                                        <property name="vexpand">true</property>
                                        <property name="height-request">160</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="end-child">
                      <object class="MajorisFilesPreviewPane" id="preview" />
                    </property>
                    <property name="resize-start-child">true</property>
                    <property name="shrink-start-child">false</property>
                  </object>
                </property>
                <property name="vexpand">true</property>
                <property name="position">224</property>
                <property name="shrink-start-child">false</property>
                <property name="resize-start-child">false</property>
              </object>
            </property>
            <property name="collapsed">true</property>
            <property name="show-sidebar">false</property>
            <property name="min-sidebar-width">180</property>
            <property name="max-sidebar-width">300</property>
          </object>
        </property>
        <property name="vexpand">true</property>
        <property name="width-request">320</property>
        <property name="height-request">240</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status">
        <property name="label" />
        <property name="halign">fill</property>
        <property name="xalign">0</property>
        <style>
          <class name="majoris-statusbar" />
        </style>
      </object>
    </child>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
  </template>
</interface>