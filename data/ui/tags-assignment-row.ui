<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesTagAssignmentRow" parent="AdwActionRow">
    <property name="use-markup">false</property>
    <property name="activatable-widget">check</property>
    <child type="prefix">
      <object class="GtkCheckButton" id="check" />
    </child>
    <child type="prefix">
      <object class="MajorisFilesTagMarker" id="marker" />
    </child>
  </template>
</interface>
