<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <object class="AdwAboutDialog" id="about">
    <property name="application-name" translatable="yes">Files</property>
    <property name="application-icon">com.majoris.files</property>
    <property name="developer-name">Majoris Developers</property>
    <property name="license-type">gpl-3-0</property>
    <property name="website">https://github.com/vovechkin02/Majoris-Files</property>
    <property name="issue-url">https://github.com/vovechkin02/Majoris-Files/issues</property>
  </object>
</interface>
