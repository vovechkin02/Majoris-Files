<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesSmbPasswordDialog" parent="AdwAlertDialog">
    <property name="heading" translatable="yes">SMB Account Password</property>
    <property name="body" translatable="yes">Set a password for network access to your local account.</property>
    <responses>
      <response id="cancel" translatable="yes">Cancel</response>
      <response id="set" translatable="yes">Set Password</response>
    </responses>
    <property name="extra-child">
      <object class="GtkPasswordEntry" id="password" />
    </property>
  </template>
</interface>
