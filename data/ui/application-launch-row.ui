<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesApplicationLaunchRow" parent="AdwActionRow">
    <child type="prefix">
      <object class="GtkImage" id="icon" />
    </child>
    <child type="suffix">
      <object class="GtkButton" id="open">
        <property name="label" translatable="yes">Open</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkButton" id="set_default">
        <property name="label" translatable="yes">Set Default</property>
      </object>
    </child>
  </template>
</interface>
