<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesViewSettingsDialog" parent="AdwPreferencesDialog">
    <child>
      <object class="AdwPreferencesPage" id="page">
        <child>
          <object class="AdwPreferencesGroup" id="group">
            <child>
              <object class="AdwComboRow" id="view">
                <property name="title" translatable="yes">View</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="size">
                <property name="title" translatable="yes">Icon Density</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="grouping">
                <property name="title" translatable="yes">Group By</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="caption">
                <property name="title" translatable="yes">Grid Metadata Caption</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="hidden_row">
                <property name="title" translatable="yes">Show Hidden Files</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="checkboxes">
                <property name="title" translatable="yes">Selection Checkboxes</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="folders">
                <property name="title" translatable="yes">Folders First</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="sort">
                <property name="title" translatable="yes">Sort By</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="direction">
                <property name="title" translatable="yes">Descending Order</property>
              </object>
            </child>
            <property name="title" translatable="yes">This Folder</property>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="columns_group">
            <property name="title" translatable="yes">List Columns</property>
          </object>
        </child>
      </object>
    </child>
    <property name="title" translatable="yes">View Settings</property>
  </template>
</interface>
