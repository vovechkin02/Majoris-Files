<interface domain="majoris-files">
  <template class="MajorisFilesPropertiesDialog" parent="AdwPreferencesDialog">
    <child>
      <object class="AdwPreferencesPage" id="general">
        <child>
          <object class="AdwPreferencesGroup" id="heading">
            <child>
              <object class="GtkBox" id="identity">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkImage" id="image">
                    <property name="icon-name">edit-copy-symbolic</property>
                    <property name="pixel-size">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="identity_name">
                    <property name="label" />
                    <property name="wrap">true</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">34</property>
                    <property name="hexpand">true</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="selectable">true</property>
                    <style>
                      <class name="heading" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="icons">
                    <property name="label" translatable="yes">Icon…</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="information">
            <property name="title" translatable="yes">Information</property>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="applications">
            <property name="title" translatable="yes">Open With</property>
            <property name="visible">false</property>
            <child>
              <object class="AdwActionRow" id="association">
                <property name="activatable-widget">change</property>
                <child type="suffix">
                  <object class="GtkButton" id="change">
                    <property name="label" translatable="yes">Change…</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child type="prefix">
                  <object class="GtkImage" id="application_icon">
                    <property name="pixel-size">32</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="organisation">
            <child>
              <object class="AdwSwitchRow" id="favorites" />
            </child>
            <property name="title" translatable="yes">Organisation</property>
            <child>
              <object class="AdwActionRow" id="tags">
                <property name="title" translatable="yes">Tags</property>
                <property name="activatable">true</property>
                <child type="suffix">
                  <object class="GtkBox" id="tag_markers">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="additional">
            <property name="title" translatable="yes">Additional Information</property>
          </object>
        </child>
        <property name="title" translatable="yes">General</property>
        <property name="name">general</property>
        <property name="icon-name">document-properties-symbolic</property>
      </object>
    </child>
    <property name="title" translatable="yes">Properties</property>
    <property name="content-width">560</property>
    <property name="content-height">620</property>
    <property name="search-enabled">false</property>
  </template>
</interface>