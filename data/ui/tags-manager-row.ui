<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesTagManageRow" parent="GtkListBoxRow">
    <property name="child">
      <object class="GtkBox" id="box">
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkMenuButton" id="color_button">
            <property name="child">
              <object class="MajorisFilesTagMarker" id="marker" />
            </property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="name_stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">label</property>
                <property name="child">
                  <object class="GtkLabel" id="label">
                    <property name="label" />
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <property name="hexpand">true</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">editor</property>
                <property name="child">
                  <object class="MajorisFilesTagNameEditor" id="editor" />
                </property>
              </object>
            </child>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkSwitch" id="sidebar_switch">
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Show in Sidebar</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
