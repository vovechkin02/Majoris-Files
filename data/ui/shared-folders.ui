<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesSharedFoldersDialog" parent="AdwPreferencesDialog">
    <child>
      <object class="AdwPreferencesPage" id="page">
        <child>
          <object class="AdwPreferencesGroup" id="group">
            <child>
              <object class="GtkButton" id="refresh">
                <property name="label" translatable="yes">Refresh Shared Folders</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <property name="title" translatable="yes">Shared Folders</property>
  </template>
</interface>
