<?xml version="1.0" encoding="UTF-8"?>
<interface domain="majoris-files">
  <template class="MajorisFilesFileOperationsView" parent="GtkBox">
    <child>
      <object class="GtkLabel" id="empty">
        <property name="label" translatable="yes">No current file operations</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="scroll">
        <property name="child">
          <object class="GtkListBox" id="jobs">
            <property name="selection-mode">none</property>
          </object>
        </property>
        <property name="min-content-width">340</property>
        <property name="vexpand">true</property>
      </object>
    </child>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
  </template>
</interface>
